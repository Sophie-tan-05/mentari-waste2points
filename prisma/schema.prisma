generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Household {
  id          String       @id @default(cuid())
  qrCode      String       @unique
  unit        String
  phone       String?      @unique
  points      Int          @default(0)
  scans       Scan[]
  redemptions Redemption[]
  vouchers    Voucher[]
  createdAt   DateTime     @default(now())
}

model Scan {
  id           String    @id @default(cuid())
  household    Household @relation(fields: [householdId], references: [id])
  householdId  String
  category     String
  weightKg     Float
  pointsEarned Int
  photoUrl     String
  photoHash    String?
  status       String    @default("pending")
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Redemption {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  rewardKey   String
  pointsCost  Int
  redeemedAt  DateTime  @default(now())
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  rewardKey   String
  rewardLabel String
  pointsCost  Int
  status      String    @default("active")
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model ApprovalBatch {
  id              String   @id @default(cuid())
  weekLabel       String
  truckWeightKg   Float
  digitalWeightKg Float
  scanCount       Int
  approvedAt      DateTime @default(now())
}
